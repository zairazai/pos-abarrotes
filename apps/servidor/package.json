{
  "name": "@pos/servidor",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del POS (Express 5)",
  "main": "dist/main-api.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node src/main-api.ts",
    "worker": "ts-node src/main-worker.ts",
    "start": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "tipos": "tsc --noEmit",
    "test": "mocha",
    "cobertura": "nyc mocha",
    "migracion:ejecutar": "typeorm-ts-node-commonjs migration:run -d src/infraestructura/base-datos/fuente-cli.ts",
    "migracion:revertir": "typeorm-ts-node-commonjs migration:revert -d src/infraestructura/base-datos/fuente-cli.ts",
    "migracion:ver": "typeorm-ts-node-commonjs migration:show -d src/infraestructura/base-datos/fuente-cli.ts",
    "datos:ejemplo": "ts-node src/main-datos-ejemplo.ts",
    "respaldo:restaurar": "ts-node src/main-restaurar.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@pos/compartido": "^1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
