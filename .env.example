# Copiar a .env y ajustar. El archivo .env no se sube al repositorio.
# Puerto e interfaz de la API: solo la propia PC se puede conectar.
PUERTO=8080
HOST=127.0.0.1
# Lista blanca de CORS, separada por comas.
ORIGENES_PERMITIDOS=http://localhost:8080
# Secreto para firmar los JWT. El instalador lo genera al azar; sin él, las sesiones se pierden al reiniciar.
JWT_SECRETO=
# Factor de costo de bcrypt para los PIN (10 a 12).
BCRYPT_COSTO=10
# PIN temporal del Dueño inicial; se pide cambiarlo en el primer acceso.
PIN_INICIAL=0000
# PostgreSQL 16 (docker/docker-compose.dev.yml usa los mismos valores).
DB_HOST=127.0.0.1
DB_PUERTO=5432
DB_USUARIO=pos
DB_CLAVE=pos_local
DB_NOMBRE=pos
# Redis 7 (mismo docker-compose.dev.yml). Si no responde, la API sigue solo con PostgreSQL.
REDIS_URL=redis://127.0.0.1:6379
# Hora diaria de la revisión de caducidades (worker), en formato HH:MM.
HORA_REVISION=06:00
# Correo y Telegram. Vacíos, los envíos se simulan y se anotan en la consola.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=pos@tienda.local
TELEGRAM_TOKEN=
# Correo donde el Dueño recibe el resumen del día. Su Telegram se vincula con /dueno en el bot.
DUENO_CORREO=dueno@tienda.local
# Respaldos al cerrar caja (se conservan los últimos 7). En desarrollo se usan el pg_dump y el
# pg_restore del contenedor de PostgreSQL; con el cliente instalado basta con "pg_dump" y "pg_restore".
RESPALDOS_DIR=C:\POS\respaldos
RESPALDO_PG_DUMP=docker exec -i pos-desarrollo-postgres-1 pg_dump
RESPALDO_PG_RESTORE=docker exec -i pos-desarrollo-postgres-1 pg_restore
# Reportes exportados a PDF y Excel; se guardan 30 días.
REPORTES_DIR=C:\POS\reportes
