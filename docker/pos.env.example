# Configuración del POS en la tienda. Se copia a C:\POS\pos.env y se cambian los valores marcados.
# No se sube a git: trae contraseñas.

# Base de datos: PostgreSQL usa POSTGRES_*, el servidor usa DB_*. Deben coincidir.
POSTGRES_USER=pos
POSTGRES_PASSWORD=CAMBIAR-por-una-clave-larga
POSTGRES_DB=pos
DB_USUARIO=pos
DB_CLAVE=CAMBIAR-por-una-clave-larga
DB_NOMBRE=pos

# Firma de los tokens de sesión: una cadena larga al azar (por ejemplo 48 bytes en base64).
JWT_SECRETO=CAMBIAR-por-un-secreto-al-azar
# PIN temporal del Dueño en el primer arranque; el sistema pide cambiarlo.
PIN_INICIAL=0000

# Revisión diaria de caducidades (HH:MM).
HORA_REVISION=06:00

# Correo del Dueño y servidor SMTP. Sin SMTP_HOST los correos se simulan.
DUENO_CORREO=dueno@tienda.local
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=pos@tienda.local

# Bot de Telegram (BotFather). Sin token el bot no arranca y los mensajes se simulan.
TELEGRAM_TOKEN=
